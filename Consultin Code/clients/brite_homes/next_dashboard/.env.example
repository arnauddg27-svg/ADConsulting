# --- BigQuery warehouse (existing dashboard data source) ---
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/brite-homes-sa-key.json  # read-only service-account key
GOOGLE_CLOUD_PROJECT=atomic-venture-404412
BIGQUERY_PROJECT_ID=atomic-venture-404412
BIGQUERY_RAW_DATASET=brite_homes_raw
BIGQUERY_MARTS_DATASET=brite_homes_marts
DASHBOARD_CLIENT_NAME=Brite Homes

# --- Ask-the-Data page (Claude warehouse Q&A) ---
ANTHROPIC_API_KEY=sk-ant-...            # required to enable /ask
ANTHROPIC_MODEL=claude-sonnet-4-6       # optional; claude-opus-4-7 for hardest questions
ASK_MAX_QUERIES=5                       # max SQL queries per question
ASK_MAX_BYTES_SCANNED=2147483648        # 2 GB per-query scan cap
ASK_MAX_TOTAL_BYTES=6442450944          # 6 GB per-question scan budget
ASK_QUERY_TIMEOUT_MS=30000              # per-query timeout
ASK_RESULT_ROW_CAP=50                   # max rows returned to Claude per query
ASK_SCHEMA_TTL_MS=3600000               # schema-catalog cache TTL (1h)
